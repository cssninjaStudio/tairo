// prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  tasks     Task[]
}

model Task {
  id         Int      @id @default(autoincrement())
  title      String
  description String
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
}

model Company {
  id    Int    @id @default(autoincrement())
  name  String
  tasks Task[]
}
