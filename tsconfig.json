{
  // https://v3.nuxtjs.org/concepts/typescript
  //
  // You have to select the path to your tsconfig.json layers
  // - ./_app/.nuxt/tsconfig.json - for the quickstarter app
  // - ./_demo/.nuxt/tsconfig.json - for the demo app
  // - ./_documentation/.nuxt/tsconfig.json - for the documentation app
  // - ./_layout_sidebar/.nuxt/tsconfig.json - for the sidebar layout and all it dependencies
  //
  "extends": "./_demo/.nuxt/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  }
}
