{
  "private": true,
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "start": "node .output/server/index.mjs",
    "allupdate": "yarn upgrade-interactive",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit",
    "test:lint": "run-s lint:eslint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./**/*.(ts|vue|css|scss|md)\"",
    "lint:prettier:fix": "prettier --write \"./**/*.(ts|vue|css|scss|md)\"",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint --fix ."
  },
  "dependencies": {},
  "devDependencies": {
    "@antfu/eslint-config": "0.25.2",
    "@ckeditor/ckeditor5-build-classic": "34.2.0",
    "@ckeditor/ckeditor5-vue": "4.0.1",
    "@headlessui/vue": "1.6.5",
    "@iconify/json": "2.1.71",
    "@iconify/vue": "3.2.1",
    "@nuxtjs/color-mode": "3.1.4",
    "@nuxtjs/tailwindcss": "^5.1.3",
    "@pinia/nuxt": "0.1.9",
    "@tailwindcss/aspect-ratio": "0.4.0",
    "@tailwindcss/forms": "0.5.2",
    "@tailwindcss/line-clamp": "0.4.0",
    "@tailwindcss/typography": "0.5.2",
    "@types/markdown-it": "12.2.3",
    "@types/prismjs": "1.26.0",
    "@vueform/slider": "2.0.10",
    "@vueuse/core": "8.7.5",
    "@vueuse/nuxt": "8.7.5",
    "autoprefixer": "10.4.7",
    "defu": "6.0.0",
    "eslint": "8.19.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-tailwindcss": "3.6.0",
    "eslint-plugin-vuejs-accessibility": "1.2.0",
    "lint-staged": "13.0.3",
    "markdown-it": "13.0.1",
    "markdown-it-prism": "2.2.4",
    "npm-run-all": "4.1.5",
    "nuxt": "3.0.0-rc.4",
    "pinia": "2.0.14",
    "prettier": "2.7.1",
    "prism-theme-vars": "0.2.3",
    "prismjs": "1.28.0",
    "typescript": "4.7.4",
    "vue-prism-component": "2.0.0",
    "vue-scrollto": "2.20.0",
    "vue-tsc": "0.38.2",
    "vue3-carousel": "0.1.40"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^14.16.0 || ^16.11.0 || ^17.0.0"
  }
}
