{
  "private": true,
  "name": "@cssninja/tairo",
  "version": "0.0.0",
  "type": "module",
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "nuxi prepare && nuxi dev .app",
    "build": "nuxi build .app",
    "demo:dev": "nuxi prepare && nuxi dev .demo",
    "demo:build": "nuxi build .demo",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit",
    "test:lint": "run-s lint:eslint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./**/*.(ts|vue|css|md)\"",
    "lint:prettier:fix": "prettier --write \"./**/*.(ts|vue|css|md)\"",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@antfu/eslint-config": "0.34.0",
    "@ckeditor/ckeditor5-build-classic": "35.4.0",
    "@ckeditor/ckeditor5-vue": "4.0.1",
    "@cssninja/nuxt-ui": "0.2.6",
    "@iconify/json": "2.1.152",
    "@nuxt/image-edge": "1.0.0-27840416.dc1ed65",
    "@nuxtjs/eslint-config": "^12.0.0",
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@pinia/nuxt": "0.4.6",
    "@types/markdown-it": "12.2.3",
    "@types/prismjs": "1.26.0",
    "@vueform/slider": "2.1.5",
    "eslint": "8.29.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-tailwindcss": "3.7.1",
    "eslint-plugin-vuejs-accessibility": "2.0.0",
    "lint-staged": "13.1.0",
    "markdown-it": "13.0.1",
    "markdown-it-prism": "2.3.0",
    "npm-run-all": "4.1.5",
    "nuxt": "3.0.0",
    "nuxt-component-meta": "0.3.8",
    "pinia": "2.0.28",
    "prettier": "2.8.1",
    "prism-theme-vars": "0.2.4",
    "prismjs": "1.29.0",
    "typescript": "4.9.4",
    "vue-prism-component": "2.0.0",
    "vue-tsc": "1.0.13",
    "vue3-carousel": "0.2.9"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "apexcharts": "^3.36.3",
    "vue3-apexcharts": "^1.4.1"
  }
}
