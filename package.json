{
  "private": true,
  "name": "tairo",
  "version": "1.3.0",
  "type": "module",
  "main": "./nuxt.config.ts",
  "packageManager": "pnpm@8.11.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "nuxi dev .app --open --no-fork",
    "build": "nuxi build .app",
    "generate": "nuxi generate .app",
    "demo:dev": "nuxi dev .demo --open --no-fork",
    "demo:build": "nuxi build .demo",
    "clean:all": "pnpm -r clean && rimraf .nuxt .output node_modules",
    "test": "run-p test:*",
    "test:tsc-demo": "nuxi typecheck .demo",
    "test:lint": "eslint .",
    "lint": "run-s lint:eslint:fix lint:eslint:fix-demo ",
    "lint:eslint:fix": "eslint --fix .",
    "lint:eslint:fix-demo": "eslint -c layers/documentation/examples/.eslintrc.cjs --fix layers/documentation/examples"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^1.4.1",
    "@typescript-eslint/eslint-plugin": "6.13.2",
    "eslint": "8.55.0",
    "eslint-plugin-sonarjs": "^0.23.0",
    "eslint-plugin-tailwindcss": "3.13.0",
    "eslint-plugin-vue": "9.19.2",
    "eslint-plugin-vuejs-accessibility": "2.2.0",
    "lint-staged": "15.2.0",
    "npm-run-all": "4.1.5",
    "rimraf": "5.0.5",
    "std-env": "3.6.0",
    "tailwindcss": "3.3.6",
    "typescript": "5.3.2",
    "vue-tsc": "1.8.24"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "postcss",
        "vue",
        "vite",
        "@unhead/vue",
        "webpack"
      ]
    },
    "patchedDependencies": {
      "smooth-dnd@0.12.1": "patches/smooth-dnd@0.12.1.patch"
    }
  }
}
