{
  "private": true,
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "start": "node .output/server/index.mjs",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit",
    "test:lint": "run-s lint:eslint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./**/*.(ts|vue|css|scss|md)\"",
    "lint:prettier:fix": "prettier --write \"./**/*.(ts|vue|css|scss|md)\"",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@antfu/eslint-config": "0.33.1",
    "@ckeditor/ckeditor5-build-classic": "35.3.2",
    "@ckeditor/ckeditor5-vue": "4.0.1",
    "@cssninja/nuxt-ui": "0.2.0",
    "@iconify/json": "2.1.146",
    "@nuxt/image-edge": "1.0.0-27827328.bc9ddc0",
    "@nuxtjs/eslint-config": "^12.0.0",
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@pinia/nuxt": "0.4.6",
    "@types/markdown-it": "12.2.3",
    "@types/prismjs": "1.26.0",
    "@vueform/slider": "2.1.5",
    "eslint": "8.28.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-tailwindcss": "3.7.1",
    "eslint-plugin-vuejs-accessibility": "2.0.0",
    "lint-staged": "13.0.4",
    "markdown-it": "13.0.1",
    "markdown-it-prism": "2.3.0",
    "npm-run-all": "4.1.5",
    "nuxt": "3.0.0",
    "nuxt-component-meta": "0.3.5",
    "pinia": "2.0.27",
    "prettier": "2.8.0",
    "prism-theme-vars": "0.2.4",
    "prismjs": "1.29.0",
    "typescript": "4.9.3",
    "vue-prism-component": "2.0.0",
    "vue-tsc": "1.0.10",
    "vue3-carousel": "0.2.8"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
