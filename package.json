{
  "private": true,
  "name": "@cssninja/tairo",
  "version": "0.0.0",
  "type": "module",
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "nuxi prepare && nuxi dev .app",
    "build": "nuxi build .app",
    "demo:dev": "pnpm demo:prepare && nuxi dev .demo",
    "demo:build": "pnpm demo:prepare && nuxi build .demo",
    "demo:prepare": "nuxi prepare && esno ./.demo/scripts/prepare-shiki.ts",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit",
    "test:lint": "run-s lint:eslint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./**/*.(ts|vue|css|md)\"",
    "lint:prettier:fix": "prettier --write \"./**/*.(ts|vue|css|md)\"",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@cssninja/nuxt-ui": "^0.3.18",
    "@nuxt/image-edge": "^1.0.0-27954023.4cee565",
    "apexcharts": "^3.37.1",
    "nuxt": "^3.2.2",
    "pinia": "^2.0.32",
    "vue3-apexcharts": "^1.4.1",
    "vue3-carousel": "^0.2.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "0.35.3",
    "@iconify/json": "2.2.27",
    "@nuxtjs/eslint-config": "12.0.0",
    "@nuxtjs/eslint-config-typescript": "12.0.0",
    "@types/fs-extra": "^11.0.1",
    "eslint": "8.34.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-tailwindcss": "3.9.0",
    "eslint-plugin-vuejs-accessibility": "2.1.0",
    "fs-extra": "11.1.0",
    "lint-staged": "13.1.2",
    "npm-run-all": "4.1.5",
    "prettier": "2.8.4",
    "tailwindcss": "3.2.7",
    "typescript": "4.9.5",
    "vue-tsc": "1.2.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "postcss",
        "shiki",
        "vue",
        "vite",
        "webpack"
      ]
    }
  }
}