{
  "private": true,
  "name": "@cssninja/tairo",
  "version": "0.0.0",
  "type": "module",
  "main": "./nuxt.config.ts",
  "engines": {
    "node": ">=16.15 <19",
    "pnpm": ">=7"
  },
  "scripts": {
    "dev": "nuxi dev .app --open",
    "build": "nuxi build .app",
    "demo:dev": "nuxi dev .demo --open",
    "demo:build": "nuxi build .demo",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit",
    "test:lint": "run-s lint:eslint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:eslint:fix-demo lint:prettier:fix",
    "lint:prettier": "prettier --check \"./**/*.(ts|vue|css|md)\"",
    "lint:prettier:fix": "prettier --write \"./**/*.(ts|vue|css|md)\"",
    "lint:eslint": "eslint -c .eslintrc.cjs --ext .vue,.ts .",
    "lint:eslint:fix": "eslint -c .eslintrc.cjs --fix --ext .vue,.ts .",
    "lint:eslint:fix-demo": "eslint -c layers/documentation/examples/.eslintrc.cjs --fix --ext .vue layers/documentation/examples"
  },
  "devDependencies": {
    "@antfu/eslint-config": "0.38.5",
    "@iconify/json": "2.2.56",
    "@nuxtjs/eslint-config": "12.0.0",
    "@nuxtjs/eslint-config-typescript": "12.0.0",
    "@parcel/watcher": "^2.1.0",
    "@types/fs-extra": "11.0.1",
    "eslint": "8.39.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-tailwindcss": "3.11.0",
    "eslint-plugin-vuejs-accessibility": "2.1.0",
    "esno": "^0.16.3",
    "fs-extra": "11.1.1",
    "lint-staged": "13.2.2",
    "npm-run-all": "4.1.5",
    "prettier": "2.8.8",
    "std-env": "^3.3.2",
    "tailwindcss": "3.3.2",
    "typescript": "5.0.4",
    "vue-tsc": "1.4.4"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "postcss",
        "vue",
        "vite",
        "@unhead/vue",
        "webpack"
      ]
    },
    "overrides": {
      "magic-string": "0.30.0",
      "consola": "3.1.0"
    }
  }
}