{
  "private": true,
  "name": "@cssninja/tairo",
  "version": "0.0.0",
  "type": "module",
  "main": "./nuxt.config.ts",
  "engines": {
    "node": ">=16.15",
    "pnpm": ">=7"
  },
  "scripts": {
    "dev": "nuxi prepare && nuxi dev .app",
    "build": "nuxi build .app",
    "demo:dev": "pnpm demo:prepare && nuxi dev _demo",
    "demo:build": "pnpm demo:prepare && nuxi build _demo",
    "doc:prepare": "pnpm demo:prepare && nuxi prepare documentation",
    "demo:prepare": "nuxi prepare && nuxi prepare _demo && pnpm demo:prepare-shiki",
    "demo:prepare-shiki": "esno ./_demo/scripts/prepare-shiki.ts",
    "test": "run-p test:*",
    "test:tsc": "pnpm demo:prepare && vue-tsc --noEmit",
    "test:lint": "run-s lint:eslint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./**/*.(ts|vue|css|md)\"",
    "lint:prettier:fix": "prettier --write \"./**/*.(ts|vue|css|md)\"",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@cssninja/nuxt-toaster": "^0.3.10",
    "@cssninja/nuxt-ui": "^0.7.1",
    "@nuxt/image-edge": "1.0.0-28004283.2a7f5cd",
    "@vee-validate/zod": "^4.8.3",
    "fast-copy": "^3.0.1",
    "nuxt": "^3.3.2",
    "nuxt-seo-kit": "^1.3.5",
    "pinia": "^2.0.33",
    "vee-validate": "^4.8.3",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "0.38.2",
    "@iconify/json": "2.2.42",
    "@nuxtjs/eslint-config": "12.0.0",
    "@nuxtjs/eslint-config-typescript": "12.0.0",
    "@types/fs-extra": "11.0.1",
    "eslint": "8.37.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-tailwindcss": "3.10.1",
    "eslint-plugin-vuejs-accessibility": "2.1.0",
    "fs-extra": "11.1.1",
    "lint-staged": "13.2.0",
    "npm-run-all": "4.1.5",
    "prettier": "2.8.7",
    "tailwindcss": "3.3.1",
    "typescript": "5.0.3",
    "vue-tsc": "1.2.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "postcss",
        "vue",
        "vite",
        "@unhead/vue",
        "webpack"
      ]
    },
    "overrides": {
      "rollup": "3.18.0",
      "vite": "4.3.0-beta.1"
    }
  }
}