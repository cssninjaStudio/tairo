{
  "private": true,
  "name": "@cssninja/tairo",
  "version": "0.0.0",
  "type": "module",
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "nuxi prepare && nuxi dev .app",
    "build": "nuxi build .app",
    "demo:dev": "nuxi prepare && nuxi dev .demo",
    "demo:build": "nuxi build .demo",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit",
    "test:lint": "run-s lint:eslint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./**/*.(ts|vue|css|md)\"",
    "lint:prettier:fix": "prettier --write \"./**/*.(ts|vue|css|md)\"",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@antfu/eslint-config": "0.35.2",
    "@ckeditor/ckeditor5-build-classic": "36.0.1",
    "@ckeditor/ckeditor5-vue": "4.0.1",
    "@cssninja/nuxt-ui": "0.3.17",
    "@iconify/json": "2.2.22",
    "@mapbox/mapbox-gl-geocoder": "5.0.1",
    "@nuxt/image-edge": "1.0.0-27919678.2f5b64b",
    "@nuxtjs/eslint-config": "12.0.0",
    "@nuxtjs/eslint-config-typescript": "12.0.0",
    "@pinia/nuxt": "0.4.6",
    "@stefanprobst/remark-shiki": "2.2.0",
    "@types/mapbox-gl": "2.7.10",
    "@types/markdown-it": "12.2.3",
    "@types/prismjs": "1.26.0",
    "@vueform/slider": "2.1.7",
    "apexcharts": "3.36.3",
    "compressorjs": "1.1.1",
    "cropperjs": "1.5.13",
    "date-fns": "2.29.3",
    "dayjs": "1.11.7",
    "eslint": "8.34.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-tailwindcss": "3.8.3",
    "eslint-plugin-vuejs-accessibility": "2.1.0",
    "lint-staged": "13.1.2",
    "mapbox-gl": "2.12.1",
    "markdown-it": "13.0.1",
    "markdown-it-prism": "2.3.0",
    "npm-run-all": "4.1.5",
    "nuxt": "3.2.0",
    "nuxt-component-meta": "0.4.3",
    "nuxt-config-schema": "0.4.4",
    "nuxt-swiper": "1.0.0",
    "pinia": "2.0.30",
    "prettier": "2.8.4",
    "prism-theme-vars": "0.2.4",
    "prismjs": "1.29.0",
    "rehype-external-links": "2.0.1",
    "rehype-raw": "6.1.1",
    "rehype-sanitize": "5.0.1",
    "rehype-stringify": "9.0.3",
    "remark-gfm": "3.0.1",
    "remark-parse": "10.0.1",
    "remark-rehype": "10.1.0",
    "shiki-es": "0.2.0",
    "typescript": "4.9.5",
    "unified": "10.1.2",
    "v-calendar": "3.0.0-alpha.8",
    "vue-prism-component": "2.0.0",
    "vue-tsc": "1.1.0",
    "vue-upload-component": "3.1.6",
    "vue3-apexcharts": "1.4.1",
    "vue3-carousel": "0.2.9",
    "vue3-popper": "1.5.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}